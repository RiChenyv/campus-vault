# ============================================================
#  Campus Vault 上线配置模板
#
#  用法：把这个文件复制成「上线.env」，改成你自己的值，然后：
#      cd D:\CampusVault\server
#      node --env-file=..\上线.env src/index.ts
#
#  ⚠️ 这个文件里有密码 —— 不要提交到任何代码仓库、不要发给别人、
#     不要放进网盘同步目录。
# ============================================================

# ---- 监听地址 ----------------------------------------------------
# 本机自用（默认）：127.0.0.1 —— 只有这台电脑能打开
# 对外（上线）：  0.0.0.0   —— 但要先把下面几项配好，否则后端会**拒绝启动**
HOST=0.0.0.0
PORT=5175

# ---- 数据目录 ----------------------------------------------------
# 数据库和上传的文件都在这里。留空 = server/data
# 上线建议写成绝对路径，换工作目录也不会找错地方。
# DATA_DIR=D:\CampusVault\server\data

# ---- 管理员账号 --------------------------------------------------
# 首次启动会创建这个账号。密码必填 —— 不填就会用**写在代码里的初始密码**，
# 而那个密码是公开的，所以非本机监听时后端会直接拒绝启动。
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=在这里填一个你自己的强密码

# ---- 注册开关 ----------------------------------------------------
# 单人应用在公网上必须关掉，否则任何人都能注册账号、往你服务器传文件。
# 1 = 允许注册，0 = 关闭
ALLOW_REGISTER=0

# ---- 油猴脚本要访问的后端地址 ------------------------------------
# 脚本是在"运行它的那台设备"上发请求的：
#   · 不填 → 脚本连 127.0.0.1，只有在跑脚本的那台电脑上才有效
#   · 填你的公网地址 → 换了电脑、手机也能导入
# 必须是 **https**（学校页面是 https，往 http 发请求会被浏览器按混合内容拦掉）
# PUBLIC_API_BASE=https://你的域名/api

# ---- 会话 cookie 的 Secure 标志 ----------------------------------
# 正常情况不用设：反代会透传协议，后端自己判断。
# 如果你的反代没透传 X-Forwarded-Proto，就设成 1 强制加上。
# COOKIE_SECURE=1

# ---- 前端静态文件 ------------------------------------------------
# 后端会顺手把项目根目录的 dist/ 一起提供（网页 + 接口同一个端口，
# 于是不需要 nginx）。改这里可以换目录；设 0 表示只提供接口。
# WEB_DIR=../dist
# SERVE_WEB=0

# ---- GitHub 接口令牌（可选）--------------------------------------
# 不填的话 GitHub 相关功能按匿名 60 次/小时限流。
# GITHUB_TOKEN=

{
  "name": "campus-vault-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Campus Vault 后端：账号 / 文件存储 / 灵感 / 待办 / 书签 / 活动日志 / GitHub 代理",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node test/run.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:e2e:data": "node test/e2e-data.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
